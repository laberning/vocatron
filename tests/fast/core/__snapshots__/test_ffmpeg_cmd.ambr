  'ffmpeg -nostdin -y -v info -f lavfi -i color=c=0x000000:s=960x720:r=30 -i /work/Artist - Title/audio.m4a -vf subtitles=filename=/work/Artist - Title/lyrics.ass:fontsdir=/pkg/vocatron/fonts,scale=in_color_matrix=bt601:in_range=tv:out_color_matrix=bt709:out_range=tv,format=yuv420p,setparams=colorspace=bt709:color_primaries=bt709:color_trc=bt709:range=tv -map 0:v -map 1:a -c:v libx264 -preset medium -crf 18 -pix_fmt yuv420p -colorspace bt709 -color_primaries bt709 -color_trc bt709 -color_range tv -c:a copy -shortest -movflags +faststart -map_metadata -1 /out/Artist - Title.part.mp4'
